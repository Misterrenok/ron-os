[Unit]
Description=Hermes Telegram personal voice bridge
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0
StartLimitBurst=8

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=90
TimeoutStartSec=120
LimitCORE=0
User=hermes
Group=hermes
WorkingDirectory=/home/hermes/.hermes/telegram-voice-bridge
Environment=HOME=/home/hermes
Environment=HERMES_HOME=/home/hermes/.hermes
Environment=PYTHONUNBUFFERED=1
Environment=TOKENIZERS_PARALLELISM=false
ExecStart=/home/hermes/.hermes/telegram-voice-bridge/.venv/bin/python voice_bridge.py /home/hermes/.hermes/telegram-voice-bridge/config.json
Restart=on-failure
RestartSec=30
TimeoutStopSec=15
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/hermes/.hermes
ReadWritePaths=/home/hermes/.cache
RuntimeDirectory=telegram-voice-bridge
RuntimeDirectoryMode=0700
MemoryHigh=2500M
MemoryMax=3G
CPUQuota=150%
TasksMax=128
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=60s
LogRateLimitBurst=100

[Install]
WantedBy=multi-user.target
